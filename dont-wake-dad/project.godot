; Engine configuration file.
; Generated for Don't Wake Dad
; Godot 4.2+

config_version=5

[application]

config/name="Don't Wake Dad"
config/description="Sneak through the house. Don't wake Dad."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.2", "Mobile")
