[gd_scene load_steps=5 format=3 uid="uid://game001"]

[ext_resource type="Script" path="res://scripts/game.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://entities/player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://entities/dad.tscn" id="3_dad"]
[ext_resource type="PackedScene" path="res://scenes/hud.tscn" id="4_hud"]

[node name="Game" type="Node2D"]
script = ExtResource("1_game")

; Dark global ambient overlay
[node name="AmbientDark" type="CanvasModulate" parent="."]
color = Color(0.15, 0.15, 0.2, 1)

; Level content loaded at runtime into this container
[node name="LevelContainer" type="Node2D" parent="."]

; Player entity
[node name="Player" type="CharacterBody2D" parent="." instance=ExtResource("2_player")]
position = Vector2(195, 600)

; Dad entity
[node name="Dad" type="CharacterBody2D" parent="." instance=ExtResource("3_dad")]
position = Vector2(195, 100)

; Camera follows player
[node name="Camera2D" type="Camera2D" parent="."]
position_smoothing_enabled = true
position_smoothing_speed = 6.0

; Light flicker effect overlay (full screen, toggled during chase)
[node name="LightFlicker" type="ColorRect" parent="."]
z_index = 90
offset_left = -1000
offset_top = -1000
offset_right = 1000
offset_bottom = 1000
color = Color(1, 1, 1, 0)
mouse_filter = 2

; HUD canvas layer
[node name="HUD" type="CanvasLayer" parent="." instance=ExtResource("4_hud")]

; Caught overlay — clean binary choice
[node name="CaughtOverlay" type="CanvasLayer" parent="."]
layer = 100
visible = false

[node name="BG" type="ColorRect" parent="CaughtOverlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.82)
mouse_filter = 0

[node name="DadFace" type="Label" parent="CaughtOverlay"]
layout_mode = 0
offset_left = 0
offset_top = 160
offset_right = 390
offset_bottom = 300
text = "😡"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 100

[node name="CaughtLabel" type="Label" parent="CaughtOverlay"]
layout_mode = 0
offset_left = 0
offset_top = 305
offset_right = 390
offset_bottom = 360
text = "DAD CAUGHT YOU"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 28
modulate = Color(1.0, 0.2, 0.2, 1)

[node name="SubLabel" type="Label" parent="CaughtOverlay"]
layout_mode = 0
offset_left = 0
offset_top = 365
offset_right = 390
offset_bottom = 400
text = "What do you want to do?"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 16
modulate = Color(0.75, 0.75, 0.75, 1)

; Primary action — extra life via ad
[node name="ExtraLifeButton" type="Button" parent="CaughtOverlay"]
layout_mode = 0
offset_left = 30
offset_top = 430
offset_right = 360
offset_bottom = 510
text = "📺  Watch Ad = Extra Life"
theme_override_font_sizes/font_size = 21
modulate = Color(1.0, 0.9, 0.2, 1)

; Secondary — give up
[node name="GiveUpButton" type="Button" parent="CaughtOverlay"]
layout_mode = 0
offset_left = 100
offset_top = 530
offset_right = 290
offset_bottom = 580
text = "Give Up"
theme_override_font_sizes/font_size = 17
modulate = Color(0.55, 0.55, 0.55, 1)

; Noise-reactive red vignette — alpha controlled by game.gd
[node name="NoiseVignette" type="CanvasLayer" parent="."]
layer = 5

[node name="VignetteRect" type="ColorRect" parent="NoiseVignette"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.8, 0.0, 0.0, 0.0)
mouse_filter = 2
